[Unit]
Description=Gwanje agent orchestration worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gwanje-agent
WorkingDirectory=/opt/gwanje-agent
EnvironmentFile=/etc/gwanje-agent.env
# /etc/gwanje-agent.env: LLM_API_URL=https://llm.example.com/v1/chat/completions
# LLM_API_KEY and LLM_API_MODEL are configured in the same environment file.
ExecStart=/usr/bin/node /opt/gwanje-agent/agent-worker.mjs
Restart=always
RestartSec=10
TimeoutStopSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
