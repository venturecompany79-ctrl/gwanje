# 관제 앱 URL (HTTPS, localhost만 HTTP 허용)
AGENT_APP_URL=
# 모델 Chat Completions URL·키·모델 이름 (실제 모델 사용 시 URL·키 필수)
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
# 태스크를 생성할 활성 사용자 profile UUID
AGENT_CREATOR_ID=
# true이면 실제 모델 없이 모의 응답 사용
AGENT_WORKER_MOCK=
# AGENT_WORKER_SECRET은 앱의 .env.local 값을 자동으로 사용합니다.

# 아래 트리거 설정은 API 서버(.env.local 또는 Vercel 환경변수)에도 설정해야 합니다.
# true일 때만 자동 시작 및 dry-run 활성화. 기본 비활성.
AGENT_TRIGGER_ENABLED=
# 대표님 profile UUID. 이 사용자의 tenant만 자동 시작 대상입니다.
AGENT_TRIGGER_PROFILE_ID=
# Asia/Seoul 기준 하루 자동 시작 한도. 미설정 기본 5 (0~100).
AGENT_TRIGGER_DAILY_LIMIT=
