{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run export:web",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/mobile/:path*",
      "destination": "https://gwanje.vercel.app/api/mobile/:path*"
    },
    {
      "source": "/((?!api/|_expo/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
