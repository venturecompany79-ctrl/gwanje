{
  "name": "gwanje-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist && npm run check:web-bundle",
    "check:web-bundle": "node scripts/check-web-bundle.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run export:web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "expo": "~57.0.4",
    "expo-blur": "^57.0.0",
    "expo-constants": "^57.0.2",
    "expo-crypto": "^57.0.0",
    "expo-device": "^57.0.0",
    "expo-haptics": "^57.0.0",
    "expo-linking": "~57.0.2",
    "expo-notifications": "~57.0.3",
    "expo-router": "~57.0.4",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "typescript": "^6.0.3"
  }
}
