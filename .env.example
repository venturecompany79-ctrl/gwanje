# ============================================================================
# 관제(gwanje) 환경변수 예시 — 실제 값은 .env.local에 (gitignore됨, 커밋 금지)
# ============================================================================

# ── 필수 (공개 / NEXT_PUBLIC_ = 클라이언트 번들에 포함됨) ─────────────────────
# Supabase Dashboard → Project Settings → API 에서 확인.
# NEXT_PUBLIC_SUPABASE_URL은 Project URL 전체. 예: https://<project-ref>.supabase.co
# anon key는 공개 키이며, 실제 데이터 격리는 RLS가 담당한다(서버 service_role 키는 사용하지 않음).
#
# 운영(Vercel) 동작:
#  - 이 두 값이 있으면 로그인 보호 + RLS 기반 실제 데이터 모드.
#  - 로컬 개발(NODE_ENV=development, Vercel 아님)에서 값이 비면 "데모 데이터 모드".
#  - Vercel 배포(VERCEL=1)에서 값이 비면 데모로 열리지 않고 /configuration-error로 차단된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 선택 (비공개 / 로컬 스크립트 전용 — 운영 런타임에서는 불필요) ──────────────
# `npm run supabase:smoke`에서 로그인/RLS까지 검증할 때만 로컬에 설정.
# 운영 계정 비밀번호이므로 절대 커밋하지 말 것.
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=

# `npm run supabase:push:env`(원격 DB 마이그레이션)에서 CLI가 DB 비밀번호를 요구할 때만.
# Supabase Dashboard → Project Settings → Database → Database password.
SUPABASE_DB_PASSWORD=

# ── Google Drive 동기화 (비공개 / 서버 전용 — 절대 NEXT_PUBLIC_ 금지) ──────────
# 사용자별 Google Drive 자동 동기화 기능에 필요. 미설정 시 설정 화면의
# "Google Drive 연결" 섹션이 비활성으로 표시되고 동기화 잡은 만들어지지 않는다.
#
# Google Cloud Console → APIs & Services → Credentials 에서 OAuth 2.0 클라이언트 생성.
#  - 승인된 리디렉션 URI에 GOOGLE_REDIRECT_URI를 그대로 등록할 것.
#  - OAuth 동의 화면 scope에 `.../auth/drive.file`만 추가(전체 drive 권한 사용 안 함).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 콜백 URL 전체. 로컬: http://localhost:3000/api/google-drive/callback
#                운영: https://<도메인>/api/google-drive/callback
GOOGLE_REDIRECT_URI=

# refresh token 암호화 키 — AES-256-GCM. 32바이트를 base64로 인코딩한 값.
# 생성 예: `openssl rand -base64 32`. 분실 시 모든 연결을 재인증해야 한다.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# 동기화 워커(/api/google-drive/sync) 호출 보호용 시크릿.
# Vercel Cron 또는 외부 스케줄러가 Authorization: Bearer <CRON_SECRET> 로 호출한다.
# 생성 예: `openssl rand -hex 32`.
CRON_SECRET=

# 동기화 워커가 사용자 세션 없이 storage 파일을 읽고 잡을 처리하려면 필요(RLS 우회).
# Supabase Dashboard → Project Settings → API → service_role key. 절대 클라이언트 노출 금지.
# (구독 결제의 결제 승인/상태 전이/웹훅 처리, 기업별 공유 대시보드도 이 키로 동작한다.)
SUPABASE_SERVICE_ROLE_KEY=

# ── 기업별 공유 대시보드 (/share/<token> · 서버 전용 — 절대 NEXT_PUBLIC_ 금지) ──
# 고객사 대표용 공유 세션 쿠키의 HMAC 서명 시크릿.
# 이 값과 SUPABASE_SERVICE_ROLE_KEY가 모두 있어야 공유 대시보드가 동작한다.
# 생성 예: `openssl rand -base64 32`. 변경 시 모든 대표의 로그인 세션이 무효화된다.
SHARE_COOKIE_SECRET=

# ── 회원가입 (Google OAuth + 이메일 / 비공개 · 서버 전용 — 절대 NEXT_PUBLIC_ 금지) ──
# "true"일 때만 /signup·/auth/callback·워크스페이스 프로비저닝이 동작한다.
# 함께 필요한 외부 설정(운영 Supabase Dashboard):
#  - Auth → "Allow new users to sign up" ON (프로젝트 수준 — #1 함정)
#  - Auth → Providers → Google 활성화(클라이언트 ID/secret) — Google 가입/로그인
#  - Auth → Providers → Email: 가입 허용 ON + "Confirm email" OFF (즉시 가입 정책)
#  - URL Configuration의 Redirect URLs에 https://<도메인>/auth/callback 추가
#  - Google Cloud Console OAuth 클라이언트의 승인된 리디렉션 URI에
#    https://<project-ref>.supabase.co/auth/v1/callback 추가 (Drive용 URI와 공존 가능)
SIGNUP_ENABLED=false

# ── AI 기능 (미팅 보고서 생성 / 서버 전용) ───────────────────────────────
# 기업 가져오기와 컨설턴트별 AI 비서에 사용. 절대 NEXT_PUBLIC_ 금지.
GEMINI_API_KEY=
# 선택: 대시보드 AI 비서 모델. 비우면 gemini-2.5-flash.
ASSISTANT_AI_MODEL=
# 선택: 비정형 기업 가져오기 모델. 비우면 앱 기본값 사용.
IMPORT_AI_MODEL=

# 미팅 보고서 생성에 사용. 절대 NEXT_PUBLIC_ 금지.
ANTHROPIC_API_KEY=
# 선택: 미팅 보고서 생성 전용 모델. 비우면 앱 기본값 사용.
REPORT_AI_MODEL=

# ── 정부지원사업 추천 동기화 (비공개 / 서버 전용 — 절대 NEXT_PUBLIC_ 금지) ─────
# 기업마당 OpenAPI crtfcKey. `/api/gov-programs/sync`가 공유 공고 풀을 갱신한다.
BIZINFO_API_KEY=
# data.go.kr serviceKey. K-Startup(15125364), 중기부 사업공고(15113297),
# 과기정통부 사업공고(15074634)에 공통 사용하되 API별 활용신청 승인이 필요하다.
DATA_GO_KR_API_KEY=

# ── 구독 결제 (Toss Payments 자동결제/빌링키) ────────────────────────────────
# ⚠️ 자동결제는 운영 전 Toss와 별도 계약/리스크 심사가 필요. 계약 전에는 테스트키 +
#    BILLING_ENABLED=false(또는 미설정)로 둔다 → 결제 UI는 "준비 중"으로 안내된다.
#
# clientKey는 공개키 — 브라우저 결제 SDK가 사용하므로 NEXT_PUBLIC_ 접두사를 쓴다.
# Toss 개발자센터 → 내 개발정보 → 자동결제(빌링) 키.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
# secretKey는 비공개 — 절대 NEXT_PUBLIC_ 금지(클라이언트 노출 시 결제 도용 위험).
TOSS_PAYMENTS_SECRET_KEY=
# 웹훅 서명 검증용 시크릿(설정 시 본문 HMAC-SHA256 검증). Toss 콘솔 웹훅 설정과 일치시킬 것.
TOSS_PAYMENTS_WEBHOOK_SECRET=
# 빌링키 암호화 키 — AES-256-GCM. 32바이트를 base64로 인코딩. 예: openssl rand -base64 32
BILLING_KEY_ENCRYPTION_KEY=
# 정기결제 배치(/api/billing/cron) 호출 보호용 시크릿. Authorization: Bearer <값>.
# 생성 예: openssl rand -hex 32.
BILLING_CRON_SECRET=
# 결제 기능 활성 플래그(서버). "true"일 때만 결제 플로우·접근 제어가 동작한다.
BILLING_ENABLED=false
