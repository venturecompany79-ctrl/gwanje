# Supabase 프로젝트 설정 (https://supabase.com/dashboard → Project Settings → API)
# NEXT_PUBLIC_SUPABASE_URL은 Project URL 전체를 입력합니다. 예: https://<project-ref>.supabase.co
# 이 값이 없으면 앱은 "데모 데이터 모드"로 동작합니다 (로그인 없이 /app 접근 가능, 화면 확인용).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 선택: `npm run supabase:smoke`에서 로그인/RLS까지 확인할 때만 로컬에 설정합니다.
# 운영 비밀번호는 커밋하지 마세요.
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=

# 선택: Supabase CLI가 원격 DB 비밀번호를 요구할 때만 로컬에 설정합니다.
# Supabase Dashboard > Project Settings > Database > Database password
SUPABASE_DB_PASSWORD=
