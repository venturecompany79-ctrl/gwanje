# ============================================================================
# 관제(gwanje) 환경변수 예시 — 실제 값은 .env.local에 (gitignore됨, 커밋 금지)
# ============================================================================

# ── 필수 (공개 / NEXT_PUBLIC_ = 클라이언트 번들에 포함됨) ─────────────────────
# Supabase Dashboard → Project Settings → API 에서 확인.
# NEXT_PUBLIC_SUPABASE_URL은 Project URL 전체. 예: https://<project-ref>.supabase.co
# anon key는 공개 키이며, 실제 데이터 격리는 RLS가 담당한다(서버 service_role 키는 사용하지 않음).
#
# 운영(Vercel) 동작:
#  - 이 두 값이 있으면 로그인 보호 + RLS 기반 실제 데이터 모드.
#  - 로컬 개발(NODE_ENV=development, Vercel 아님)에서 값이 비면 "데모 데이터 모드".
#  - Vercel 배포(VERCEL=1)에서 값이 비면 데모로 열리지 않고 /configuration-error로 차단된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 선택 (비공개 / 로컬 스크립트 전용 — 운영 런타임에서는 불필요) ──────────────
# `npm run supabase:smoke`에서 로그인/RLS까지 검증할 때만 로컬에 설정.
# 운영 계정 비밀번호이므로 절대 커밋하지 말 것.
SUPABASE_SMOKE_EMAIL=
SUPABASE_SMOKE_PASSWORD=

# `npm run supabase:push:env`(원격 DB 마이그레이션)에서 CLI가 DB 비밀번호를 요구할 때만.
# Supabase Dashboard → Project Settings → Database → Database password.
SUPABASE_DB_PASSWORD=
